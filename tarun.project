//app/layout.tsx
import "../styles/globals.css";
import { Header } from "@/components/Header";
import { Footer } from "@/components/Footer";

export default function RootLayout({ children }: { children: React.ReactNode }) {
  return (
    <html lang="en">
      <body className="bg-white text-gray-900 dark:bg-gray-900 dark:text-white">
        <Header />
        <main className="min-h-screen px-4 md:px-16 py-8">{children}</main>
        <Footer />
      </body>
    </html>
  );
}

//app/page.tsx
import { Hero } from "@/components/Hero";
import { FeaturedProducts } from "@/components/FeaturedProducts";

export default function HomePage() {
  return (
    <>
      <Hero />
      <FeaturedProducts />
    </>
  );
}

//components/Header.tsx
"use client";
import Link from "next/link";
import { useState } from "react";

export function Header() {
  const [cartOpen, setCartOpen] = useState(false);

  return (
    <header className="flex justify-between items-center p-4 shadow-md sticky top-0 bg-white dark:bg-gray-800 z-50">
      <Link href="/" className="text-2xl font-bold">
        ShopX
      </Link>
      <nav className="space-x-4">
        <Link href="/products">Products</Link>
        <button onClick={() => setCartOpen(!cartOpen)} className="relative">
          🛒
          <span className="absolute -top-1 -right-2 bg-red-500 text-white rounded-full px-2 text-xs">
            0
          </span>
        </button>
      </nav>
    </header>
  );
}

//components/Hero.tsx
export function Hero() {
  return (
    <section className="text-center py-24 bg-gradient-to-r from-purple-500 to-pink-500 text-white rounded-xl">
      <h1 className="text-4xl md:text-6xl font-bold mb-4">Discover the Best Deals</h1>
      <p className="text-lg md:text-xl">Shop the latest trends at unbeatable prices</p>
    </section>
  );
}

//components/FeaturedProducts.tsx
import useSWR from "swr";
import { ProductCard } from "./ProductCard";

const fetcher = (url: string) => fetch(url).then(res => res.json());

export function FeaturedProducts() {
  const { data, error, isLoading } = useSWR("https://fakestoreapi.com/products?limit=4", fetcher);

  if (isLoading) return <p>Loading...</p>;
  if (error) return <p>Error loading products.</p>;

  return (
    <section className="py-12">
      <h2 className="text-2xl font-semibold mb-6">Featured Products</h2>
      <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        {data.map((product: any) => (
          <ProductCard key={product.id} product={product} />
        ))}
      </div>
    </section>
  );
}

//components/ProductCard.tsx
export function ProductCard({ product }: { product: any }) {
  return (
    <div className="border rounded-lg p-4 shadow hover:shadow-lg transition">
      <img src={product.image} alt={product.title} className="h-40 object-contain mx-auto mb-4" />
      <h3 className="text-sm font-medium mb-2 line-clamp-2">{product.title}</h3>
      <p className="font-bold mb-2">${product.price}</p>
      <button className="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
        Add to Cart
      </button>
    </div>
  );
}
